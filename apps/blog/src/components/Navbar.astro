---
const pathname = Astro.url.pathname;
const links = [
	{ href: '/', label: 'Accueil' },
	{ href: '/archive/', label: 'Archives' },
	{ href: '/tags/', label: 'Tags' },
	{ href: '/recherche/', label: 'Recherche' },
	{ href: '/progress/', label: 'Progression' },
	{ href: '/about/', label: 'À propos' }
];
---

<header class="sticky top-0 z-40 backdrop-blur border-b border-zinc-200 dark:border-zinc-800 bg-white/80 dark:bg-zinc-950/80">
	<nav class="max-w-3xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between gap-4">
		<a href="/" class="site-title font-mono font-bold text-zinc-900 dark:text-zinc-100 no-underline tracking-tight">
			ablog
		</a>
		<div class="hidden sm:flex items-center gap-5">
			{links.map((link) => (
				<a
					href={link.href}
					class:list={[
						'text-sm font-medium no-underline transition-colors',
						pathname === link.href
							? 'text-emerald-600 dark:text-emerald-400'
							: 'text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100'
					]}
				>
					{link.label}
				</a>
			))}
		</div>
		<div class="flex items-center gap-3">
			<a href="/about/" class="sm:hidden text-sm text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100 no-underline">À propos</a>
			<button
				id="theme-toggle"
				type="button"
				aria-label="Basculer le thème"
				class="p-2 rounded-lg border border-zinc-200 dark:border-zinc-700 text-zinc-500 dark:text-zinc-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
			>
				<span data-theme-icon="dark">☾</span>
				<span data-theme-icon="light" hidden>☀</span>
			</button>
		</div>
	</nav>
</header>

<script is:inline>
	(() => {
		const btn = document.getElementById('theme-toggle');
		if (!btn) return;
		const dark = () => document.documentElement.classList.contains('dark');
		const render = () => {
			const isDark = dark();
			document.querySelector('[data-theme-icon="dark"]').hidden = !isDark;
			document.querySelector('[data-theme-icon="light"]').hidden = isDark;
		};
		btn.addEventListener('click', () => {
			const isDark = !dark();
			document.documentElement.classList.toggle('dark', isDark);
			localStorage.setItem('theme', isDark ? 'dark' : 'light');
			render();
		});
		render();
	})();
</script>