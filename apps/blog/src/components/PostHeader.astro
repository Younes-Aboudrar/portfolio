---
import { formatDate } from '../lib/utils';
interface Props {
	title: string;
	description?: string;
	date?: Date;
	updatedDate?: Date;
	tags?: string[];
}
const { title, description, date, updatedDate, tags = [] } = Astro.props;
---

<header class="not-prose border-b border-zinc-200 dark:border-zinc-800 pb-8 mb-10">
	{date && (
		<p class="font-mono text-sm text-emerald-600 dark:text-emerald-400 mb-3">
			{formatDate(date)}
			{updatedDate && <span class="text-zinc-400"> · mis à jour le {formatDate(updatedDate)}</span>}
		</p>
	)}
	<h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 leading-tight">
		{title}
	</h1>
	{description && (
		<p class="mt-4 text-lg text-zinc-600 dark:text-zinc-400 leading-relaxed">{description}</p>
	)}
	{tags.length > 0 && (
		<div class="flex flex-wrap gap-2 mt-6">
			{tags.map((tag) => (
				<a
					href={`/tags/${tag}/`}
					class="font-mono text-xs px-2.5 py-1 rounded-full border border-zinc-200 dark:border-zinc-700 text-zinc-600 dark:text-zinc-300 hover:border-emerald-500 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors no-underline"
				>
					#{tag}
				</a>
			))}
		</div>
	)}
</header>