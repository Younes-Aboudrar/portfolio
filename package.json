{
	"name": "aboudrar.dev",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*",
		"workers/*"
	],
	"scripts": {
		"test": "npm run test --workspaces --if-present",
		"dev": "npm run dev --workspace @aboudrar/portfolio",
		"build": "npm run build --workspaces --if-present",
		"preview": "npm run preview --workspace @aboudrar/portfolio",
		"check": "npm run check --workspaces --if-present",
		"dev:blog": "npm run dev --workspace @aboudrar/blog -- --port 4321",
		"dev:wiki": "npm run dev --workspace @aboudrar/wiki -- --port 4322",
		"dev:contact": "npm run dev --workspace @aboudrar/contact-worker -- --env development",
		"test:browser": "playwright test"
	},
	"engines": {
		"node": ">=22.23.4"
	},
	"devDependencies": {
		"@playwright/test": "^1.65.0"
	}
}
